html{
    font-size: 62.5%;
}

body{
    padding: 0;
    margin: 0;
    font-family: cursive;
    background-color: rgb(0, 0, 0);
    color: aqua;
}

#encabezado{
    font-size: 2rem;
    border: 0.2rem solid gold;
    text-align: center;
    color: greenyellow;
}

#encabezado h1{
    text-shadow: 0.2rem 0.2rem 0.2rem ;
}

.contenedor-tabla{
    font-size: 2rem;
    border: 0.2rem solid red;
    overflow: scroll;
    padding: 5px;
}

.tabla-alumnos{
    
    width: 100%;
    height: 100%;
    border-collapse: collapse; /*Se usa para fusionar los border y no dejas que haya un espacion entre un border  y otro*/
}

.tabla-alumnos th, .tabla-alumnos td{
    border: 0.1rem solid blue ;
    padding: 0.3rem;
    text-align: center;
}

.tabla-alumnos th{
    background-color: brown;
    color: rgb(0, 255, 0);
    border: 0.2rem  0.2rem  0.2rem solid white;
}

.tabla-alumnos tr:nth-child(even){
    background-color: rgb(214, 173, 59);
    color: black;
}

.tabla-alumnos tr:hover{
    background-color: aqua;
    color: white;
}
