html{
    font-size: "en";
}

body{
    margin: 0%;
    background: linear-gradient(yellow, red);
    
}

#navegacion{
    font-size: 1.5rem;
    
   
}

#navegacion ul li{
    display: flex;
    background-color: aqua;
    padding: 0%;
    color: aliceblue;
    font-size: 2rem;
    flex-direction: row;
    border: 1rem solid red;
}

#encabezado{
    border: 0.7rem solid black;
    display: flex;
    flex-wrap: wrap;
    flex-direction: row;
    justify-content: space-between;
    flex-shrink: 1;
    align-items: center;
    height: 30rem;
    
}

#encabezado h1{

    text-shadow: 0.2rem 0.2rem 0.2rem solid black ;
    font-size: 5rem;
    
    color: purple;

    
}

.logo{
    border: 0.2rem solid goldenrod;

    border-radius: 50%;
    box-shadow: 0.5rem  0.9rem  0.5rem ;
   
    bottom: 20%;


}

.logo img{
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;


}

.contenedor-flexible{
    border: 0.2rem solid rgb(0, 0, 0);
    color: black;
    padding: 0.5rem;
    display: flex;/*Display flex hace un contendor flexible y QUE se acmode por Si  solo */
    flex-direction: row; /*Flex direction define el eje principla que va a trabajar flex box por defecto este eje esta en horizontal con row*/
    /*EL coluomn reverse invierte los contenidos de 3 a 1 y lo mismos para las rows*/
    /*Justify-content: Define como se otorga el espacio en el contenedor flexible a los objetos flexibles de dicho contenedor en el eje seleccionado como main.axis (x o y)*/
    justify-content: space-evenly;
    width: 100%;
    height: 100rem;
    /*Allign-items Define como se distribuye el espacio de los objetos flexibles a lo largo del eje cruzado en (cross-axis(x,y))*/
    align-items: stretch;
    /*FLex.wrap permite a los elementos, si el contenedor es mas pequeño que el tamañlo del elmento especificado*/
    flex-wrap:wrap
}

.contenedor-flexible article{
    background-color: purple;
    height: 20rem;
       /* width: 20rem; eso esta comentado para estirar los contenedores flexibles con stech*/

     width: 20rem;  
    border: 0.5rem  solid black;
    color: yellow;
    margin: 0.3rem;
}

.objeto-flexible1{
    flex-grow: 1; /*Reparte el espacio de los contenedores segun lo que indicamos mayor a menor*/
}


.objeto-flexible2{
    flex-grow: 1;

}


.objeto-flexible3{
  
    flex-shrink: 1;


}


.objeto-flexible4{
  
    flex-shrink: 1;


}

.objeto-flexible5{
  
    flex-shrink: 1;


}




.titulo_main{
    font-size: 2rem;
    text-align: center;
    text-shadow: 3rem black;
}

#productos{
    border: 0.2rem solid black;
     display: flex;
     flex-direction: row;
     justify-content: space-evenly;
     align-items: center;
     background:linear-gradient(green, purple) ;
     padding: 1rem;
     flex-wrap: wrap;
}

.producto{
    display: flex;
    color: black;
    flex-direction: column;
    font-size: 2rem;
    justify-content: space-evenly;
    align-items: center;
    border: 0.2rem solid black;
    padding: 1rem;
    width: 30rem;
    min-width: 25rem;
}


.producto p{
    text-align: center;
}
.producto img{
    width: auto;
    height: 15rem;
    object-fit: contain;

}



