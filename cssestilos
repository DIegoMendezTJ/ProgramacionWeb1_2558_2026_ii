html{
    font-size: 62.5%;
}

body{
    padding: 0;
    margin: 0;
    font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
    background: linear-gradient(to bottom, green, blue);
    color: white;
}

#encabezado{
    border: 1rem solid gold;
    text-align: center;
}

#encabezado h1{

    font-size: 3.5rem;
    font-weight: lighter;
    color: aqua;

}

.contenedor-flotante{
    border: 1rem solid goldenrod;
    height: 15rem;
}

.contenedor-flotante p{
    font-size: 3rem;
}

.contenedor-flotante img{
    width: 10%;
    border: 1rem solid rgb(221, 9, 9);    
    float: right;
    margin: 2rem;

}


.contenedor-flotante2{
    height: 15rem;
    border: 1rem solid rgb(238, 255, 0);    
}

.contenedor-flotante2 p{
    font-size: 3rem;

}


.contenedor-flotante2 img{
    width: 10%;
    border: 1rem solid rgb(160, 16, 16);  
    float: left;
    margin: 2rem;
}




/*Consultas de medias queries
Sivern para definir estilos a elementos html, segun el tamaño de la pantallas de nuestro dispositivo
Gracias a esto se propociona una herramienta que nos river para la creacion de sitios web responsivos o adaptables
si se definen varias consultas de medios. se deben de poner en fomra dencendente segun la medida del dispositivo.
Para Mobiles su medida estandar es menor a 480px
Para tablets su medida estandar va de 480px hasta 960px
Los portatiles o pantallas de conputadoras, pcs, va de 960px hasta 1280px*/


@media screen and (max-width: 700px){

    #encabezado h1{

    font-size: 2.5rem;
    font-weight: lighter;    
    color: red;
}

.contenedor-flotante p{
    font-size: 2rem;
    color: rgb(221, 166, 95);
}

.contenedor-flotante2 p{
    font-size: 2rem;
    color: rgb(209, 147, 65);

}
}

@media screen and (max-width: 500px){

    #encabezado h1{

    font-size: 2.5rem;
    font-weight: lighter;    
    color: rgb(211, 7, 150);
}

.contenedor-flotante p{
    font-size: 2rem;
    color: rgb(123, 189, 2);
}

.contenedor-flotante2 p{
    font-size: 2rem;
    color: rgb(56, 197, 0);

}
}




